# Server
PORT=3002
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Odoo
ODOO_URL=https://blackdogpanama.odoo.com
ODOO_DB=blackdogpanama
ODOO_USERNAME=api@blackdogpanama.com
ODOO_PASSWORD=xxx

# Sync
SYNC_PRODUCTS_INTERVAL=*/5 * * * *
SYNC_CATEGORIES_INTERVAL=0 * * * *
SYNC_STOCK_INTERVAL=*/5 * * * *

# Yappy Botón de Pago V2 (Banco General)
YAPPY_V2_MERCHANT_ID=
YAPPY_V2_SECRET_KEY=
YAPPY_V2_DOMAIN=https://blackdogpanama.com
YAPPY_V2_IPN_URL=https://api.blackdogpanama.com/api/payments/yappy-v2/ipn
YAPPY_V2_API_URL=https://apipagosbg.bgeneral.cloud
